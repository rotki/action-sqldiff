{
  "name": "@rotki/action-sqldiff",
  "version": "3.0.1",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "description": "GitHub Actions to add SQLDiffs in pull requests",
  "type": "module",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "AGPL-3.0",
  "homepage": "https://github.com/rotki/action-sqldiff",
  "bugs": {
    "url": "https://github.com/rotki/action-sqldiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotki/action-sqldiff"
  },
  "author": "Rotki Solutions GmbH",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "rollup -c rollup.config.mjs",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run --coverage",
    "all": "pnpm run build && pnpm run lint && pnpm run package && pnpm test",
    "prepare": "husky",
    "release": "bumpp --no-push"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "micromatch": "4.0.8",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@octokit/types": "18.0.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@rotki/eslint-config": "5.0.1",
    "@rotki/eslint-plugin": "1.3.2",
    "@types/micromatch": "4.0.10",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.0.4",
    "bumpp": "12.3.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "make-coverage-badge": "1.2.0",
    "rollup": "4.64.7",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  }
}
