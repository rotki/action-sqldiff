{
  "name": "@rotki/action-sqldiff",
  "version": "3.1.0",
  "private": true,
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "description": "GitHub Actions to add SQLDiffs in pull requests",
  "type": "module",
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "AGPL-3.0",
  "homepage": "https://github.com/rotki/action-sqldiff",
  "bugs": {
    "url": "https://github.com/rotki/action-sqldiff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotki/action-sqldiff"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "rollup -c rollup.config.mjs",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "all": "pnpm run build && pnpm run lint && pnpm run package && pnpm test",
    "prepare": "husky",
    "release": "bumpp --no-push"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "picomatch": "4.0.7",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@octokit/types": "18.0.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@rotki/eslint-config": "8.5.0",
    "@rotki/eslint-plugin": "1.10.1",
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "5.1.1",
    "bumpp": "12.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-slop": "0.1.3",
    "eslint-plugin-tsdoc": "0.5.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "make-coverage-badge": "1.2.0",
    "rollup": "4.68.7",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "lint-staged": {
    "*.{js,ts,md,json,yml}": "eslint"
  }
}
